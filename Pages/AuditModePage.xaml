<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplicacion_SCA.Pages.AuditModePage"
             BackgroundColor="#45728F"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid IgnoreSafeArea="True">

        <Border VerticalOptions="Start" HeightRequest="280" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                    <GradientStop Color="#43AAA0" Offset="1.0" />
                    <GradientStop Color="#243782" Offset="0.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,40,40" />
            </Border.StrokeShape>
        </Border>

        <Grid>
            <VerticalStackLayout x:Name="ContenedorCabecera" VerticalOptions="Start" Padding="20,10,20,0" Spacing="10">

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,0">
                    <Border Grid.Column="0" HeightRequest="30" WidthRequest="100" HorizontalOptions="Start"
                            BackgroundColor="Transparent" Stroke="White" StrokeThickness="1.5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="17.5"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarSesionClicked" />
                        </Border.GestureRecognizers>
                        <Border.Content>
                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5" InputTransparent="True">
                                <Label x:Name="LblCerrarSesion" Text="Cerrar Sesión" TextColor="White" FontSize="11" FontAttributes="Bold" 
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border.Content>
                    </Border>

                    <Border Grid.Column="1" 
                            BackgroundColor="#22FFFFFF"
                            Stroke="Aqua"
                            StrokeThickness="1"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="40" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAbrirNotificacionesClicked" />
                        </Border.GestureRecognizers>

                        <Border.Content>
                            <Image Source="notifications.png" 
                                   WidthRequest="22" 
                                   HeightRequest="22" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" 
                                   Aspect="AspectFit" />
                        </Border.Content>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="5,-5,0,0" VerticalOptions="Start">
                    <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" BackgroundColor="#44FFFFFF" StrokeThickness="0" VerticalOptions="Start">
                        <Border.StrokeShape>
                            <Ellipse/>
                        </Border.StrokeShape>
                        <Border.Content>
                            <Image Source="user.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border.Content>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="-5">
                        <Label x:Name="LblHola" 
                               Text="Auditor Desconocido" 
                               TextColor="White" 
                               FontSize="16" 
                               Margin="0,0,20,0"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap"
                               MaxLines="3"/>
                        <Label x:Name="LblTurno" 
                               Text="Sin turno definido" 
                               TextColor="#3BF1E5" 
                               FontSize="13"
                               Margin="0,6,0,0"/>
                    </VerticalStackLayout>
                </Grid>

                <Border BackgroundColor="#22FFFFFF" StrokeThickness="0" Padding="15,6" Margin="10,-6,0,0" HorizontalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Content>
                        <Label x:Name="LblBienvenidoCentro"
                               Text="Bienvenida/o al Centro de Control"
                               TextColor="White"
                               FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Border.Content>
                </Border>
            </VerticalStackLayout>

            <Grid x:Name="ContenedorTarjeta" Margin="30,160,30,20">
                <Border BackgroundColor="#FAFAFA" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.1" />
                    </Border.Shadow>

                    <Border.Content>
                        <ScrollView VerticalScrollBarVisibility="Never">
                            <VerticalStackLayout x:Name="ContenidoTarjeta" Spacing="12" Padding="15,15,15,20">
                                <Image Source="stellantis.png"
                                       HeightRequest="35" 
                                       HorizontalOptions="Center" 
                                       Aspect="AspectFit"/>

                                <Border StrokeThickness="2" 
                                        Padding="20, 10"
                                        WidthRequest="250"
                                        BackgroundColor="Transparent"
                                        Margin="0,0,0,10">
                                    <Border.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#43AAA0" Offset="0.0" />
                                            <GradientStop Color="#243782" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Stroke>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="45" />
                                    </Border.StrokeShape>
                                    <Border.Content>
                                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                            <Label x:Name="LblModoAuditoria"
                                                   Text="MODO DE AUDITORÍA" 
                                                   TextColor="#0F2166" 
                                                   FontSize="18" 
                                                   FontAttributes="Bold" 
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border.Content>
                                </Border>

                                <Border HeightRequest="70" 
                                        StrokeThickness="0"
                                        WidthRequest="250"
                                        HorizontalOptions="Center"
                                        Background="#243782">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="45"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,7" Opacity="0.2" Radius="10"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnJaponesaClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Content>
                                        <Label x:Name="LblControlJapon"
                                               Text="CONTROL JAPÓN" 
                                               TextColor="White" 
                                               FontSize="16" 
                                               CharacterSpacing="1"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center"/>
                                    </Border.Content>
                                </Border>

                                <Border HeightRequest="70" 
                                        StrokeThickness="0"
                                        WidthRequest="250"
                                        HorizontalOptions="Center"
                                        Background="#e94e24">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="45"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,7" Opacity="0.2" Radius="10"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnScaClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Content>
                                        <Label Text="C-DPV" 
                                               TextColor="White" 
                                               FontSize="16" 
                                               CharacterSpacing="1" 
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center"/>
                                    </Border.Content>
                                </Border>

                                <Border HeightRequest="70" 
                                        StrokeThickness="0"
                                        WidthRequest="250"
                                        HorizontalOptions="Center"
                                        Background="#43aaa0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="45"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,7" Opacity="0.2" Radius="10"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDpvClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Content>
                                        <Label Text="DPV" 
                                               TextColor="White" 
                                               FontSize="16" 
                                               CharacterSpacing="1" 
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center"/>
                                    </Border.Content>
                                </Border>

                                <Border HeightRequest="70" 
                                        StrokeThickness="0"
                                        WidthRequest="250"
                                        HorizontalOptions="Center"
                                        Background="#ECA935">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="45"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,7" Opacity="0.2" Radius="10"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFormacionClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Content>
                                        <Label x:Name="LblFormacionSca"
                                               Text="FORMACIÓN SCA" 
                                               TextColor="White" 
                                               FontSize="16" 
                                               CharacterSpacing="1" 
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center"/>
                                    </Border.Content>
                                </Border>

                                <Border x:Name="BotonRRU"
                                        HeightRequest="70" 
                                        StrokeThickness="0"
                                        WidthRequest="250"
                                        HorizontalOptions="Center"
                                        Background="#282b34">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="45"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,7" Opacity="0.2" Radius="10"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRRUClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Content>
                                        <Label Text="RRU" 
                                               TextColor="White" 
                                               FontSize="16" 
                                               CharacterSpacing="1" 
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center"/>
                                    </Border.Content>
                                </Border>

                                <VerticalStackLayout x:Name="ContenedorBotonesDinamicos"
                                                     Spacing="12"
                                                     HorizontalOptions="Center">
                                </VerticalStackLayout>

                                <Label x:Name="LblFooterVersion"
                                       Text="Stellantis Vigo - Centro de Control"
                                       FontSize="11"
                                       TextColor="#325369"
                                       HorizontalOptions="Center"
                                       Margin="0,10,0,0"
                                       FontAttributes="Bold"/>

                                <Label x:Name="LblVersion"
                                       Text="..."
                                       FontSize="9"
                                       TextColor="#B0B8C1"
                                       HorizontalOptions="End"
                                       Margin="0,2,5,0"/>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border.Content>
                </Border>
            </Grid>

            <Border HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0, 85, 30, 0"
                    WidthRequest="54"
                    HeightRequest="54"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    ZIndex="100">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="27"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.15" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDocumentosClicked"/>
                </Border.GestureRecognizers>
                <Border.Content>
                    <Label Text="📁" 
                           FontSize="24" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           Margin="2,2,0,0"/>
                </Border.Content>
            </Border>

        </Grid>

        <Grid x:Name="OverlayDocumentos"
              IsVisible="False" 
              BackgroundColor="#99000000" 
              ZIndex="999">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCerrarDocumentosClicked" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White"
                    Margin="25,10,25,-30"
                    Padding="15"
                    HeightRequest="680"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto, *, Auto">
                    <Border StrokeThickness="2" 
                            Padding="20, 10"
                            WidthRequest="250"
                            BackgroundColor="Transparent"
                            Margin="0,0,0,10">
                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#43AAA0" Offset="0.0" />
                                <GradientStop Color="#243782" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="45" />
                        </Border.StrokeShape>
                        <Border.Content>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Label x:Name="LblOverlayDocumentos"
                                       Text="DOCUMENTOS" 
                                       TextColor="#0F2166" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border.Content>
                    </Border>

                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" MaximumHeightRequest="500">
                        <StackLayout x:Name="ContenedorListaPdfs" Spacing="10" Margin="10" WidthRequest="250">
                        </StackLayout>
                    </ScrollView>

                    <Border Grid.Row="2"
                            Margin="0,10,0,20"
                            WidthRequest="250"
                            HeightRequest="50"
                            StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#43AAA0" Offset="1.0" />
                                <GradientStop Color="#243782" Offset="0.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,8" Opacity="0.2" Radius="10"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarDocumentosClicked" />
                        </Border.GestureRecognizers>
                        <Border.Content>
                             <Label x:Name="LblCerrarDoc"
                                    Text="CERRAR" 
                                    TextColor="White" 
                                    CharacterSpacing="1"
                                    FontSize="16"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center" />
                        </Border.Content>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="OverlayNotificacion" IsVisible="False" Opacity="0" BackgroundColor="#B3000000" ZIndex="1000">

            <Border BackgroundColor="White"
                    Margin="25,10,25,-10"
                    HeightRequest="680"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto, Auto, *, Auto">

                    <Image Grid.Row="0"
                           Source="stellantis.png" 
                           HeightRequest="30" 
                           HorizontalOptions="Center" 
                           Aspect="AspectFit"
                           Margin="0,5,0,15"/>

                    <Border Grid.Row="1"
                            StrokeThickness="2" 
                            Padding="20, 10"
                            WidthRequest="250"
                            BackgroundColor="Transparent">
                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#43AAA0" Offset="0.0" />
                                <GradientStop Color="#243782" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="45" />
                        </Border.StrokeShape>
                        <Border.Content>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Label x:Name="LblOverlayAvisos"
                                       Text="AVISOS Y NOVEDADES" 
                                       TextColor="#0F2166" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border.Content>
                    </Border>

                    <ScrollView Grid.Row="2" MaximumHeightRequest="600" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="ContenedorNotificaciones" Padding="20,20" Spacing="10" Margin="10,10">
                        </VerticalStackLayout>
                    </ScrollView>

                    <Border Grid.Row="3"
                            Margin="0,10,0,30"
                            WidthRequest="250"
                            HeightRequest="50"
                            StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#43AAA0" Offset="1.0" />
                                <GradientStop Color="#243782" Offset="0.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,8" Opacity="0.2" Radius="10"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarNotificacionClicked" />
                        </Border.GestureRecognizers>
                        <Border.Content>
                             <Label x:Name="LblEntendido"
                                    Text="ENTENDIDO" 
                                    TextColor="White" 
                                    CharacterSpacing="1"
                                    FontSize="16"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center"/>
                        </Border.Content>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>