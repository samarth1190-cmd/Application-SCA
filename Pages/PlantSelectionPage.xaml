<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplicacion_SCA.Pages.PlantSelectionPage"
             BackgroundColor="#45728F"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid IgnoreSafeArea="True">

        <Border VerticalOptions="Start" HeightRequest="280" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                    <GradientStop Color="#43AAA0" Offset="1.0" />
                    <GradientStop Color="#243782" Offset="0.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,40,40" />
            </Border.StrokeShape>
        </Border>

        <Grid RowDefinitions="Auto, *" Padding="0,10,0,100">

            <VerticalStackLayout Grid.Row="0" VerticalOptions="Start" Padding="25,0,25,0" Spacing="10">
                <Border x:Name="BtnVolver" HeightRequest="30" WidthRequest="80" HorizontalOptions="Start" BackgroundColor="Transparent" Stroke="White" StrokeThickness="1.5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                        <Label x:Name="LblVolver" Text="← Volver" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Label x:Name="LblTituloCabecera"
                       Text="AUDITORÍA C-DPV"
                       TextColor="White"
                       FontSize="17"
                       FontAttributes="Bold"
                       CharacterSpacing="1"
                       Margin="5,10,0,0"/>
            </VerticalStackLayout>

            <Grid x:Name="ContenedorTarjeta" Grid.Row="1" Margin="30,25,30,-30">
                <Border BackgroundColor="#FAFAFA" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.1" />
                    </Border.Shadow>

                    <ScrollView VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout Spacing="15" Padding="25,30,25,30">

                            <Label x:Name="LblTitulo"
                                   Text="SELECCIONA LA PLANTA"
                                   TextColor="#0F2166"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.5"
                                   HorizontalTextAlignment="Center"/>

                            <Label x:Name="LblSubtitulo"
                                   Text=""
                                   TextColor="#90959E"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,0,0,15"/>

                            <VerticalStackLayout x:Name="ContenedorPlantas" Spacing="18" HorizontalOptions="Center"/>

                            <Label x:Name="LblEstado"
                                   Text=""
                                   TextColor="#43AAA0"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   IsVisible="False"
                                   Margin="0,10,0,0"/>

                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
