<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Aplicacion_SCA.Models"
             x:Class="Aplicacion_SCA.Pages.RRUPage"
             BackgroundColor="#3D638A"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid IgnoreSafeArea="True">

        <Border VerticalOptions="Start" HeightRequest="280" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,1">
                    <GradientStop Color="#43AAA0" Offset="1.0" />
                    <GradientStop Color="#243782" Offset="0.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,40,40" />
            </Border.StrokeShape>
        </Border>

        <Grid RowDefinitions="Auto, *, Auto" Padding="0,0,0,0">

            <VerticalStackLayout Grid.Row="0" Padding="25,10,25,0" Spacing="10">
                <VerticalStackLayout HorizontalOptions="Start" Spacing="8">
                    <Border HeightRequest="32" WidthRequest="80" HorizontalOptions="Start"
                            BackgroundColor="Transparent" Stroke="White" StrokeThickness="1.5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVolverClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="✕ Salir" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </Border>

                    <HorizontalStackLayout Spacing="6" Margin="5,0,0,0">
                        <Border WidthRequest="24" HeightRequest="24" BackgroundColor="#44FFFFFF" StrokeThickness="0">
                            <Border.StrokeShape>
                                <Ellipse/>
                            </Border.StrokeShape>
                            <Image Source="user.png" HeightRequest="12" WidthRequest="12" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="LblUsuarioNombre" Text="Auditor" TextColor="White" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout HorizontalOptions="Start" Spacing="6">
                    <Border BackgroundColor="#22FFFFFF" StrokeThickness="0" Padding="15,4" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="10">
                            <Label FontSize="13" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Modelo: " TextColor="White"/>
                                        <Span x:Name="LblModeloText" Text="..." TextColor="White" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="|" TextColor="White" Opacity="0.4" VerticalOptions="Center"/>
                            <Label FontSize="13" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Motor: " TextColor="#B3FFFFFF" />
                                        <Span x:Name="LblMotorText" Text="..." TextColor="White" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="#22FFFFFF" StrokeThickness="0" Padding="12,2" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label x:Name="LblChasisText" Text="VIN: 00000000" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Border x:Name="ContenedorTarjeta" Grid.Row="1" Margin="25,15,25,-30" BackgroundColor="#FAFAFA" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Padding="20,25,20,10" Spacing="15">
                    <Border StrokeThickness="2" Padding="20, 10" WidthRequest="250" BackgroundColor="Transparent">
                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#43AAA0" Offset="0.0" />
                                <GradientStop Color="#243782" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="45" />
                        </Border.StrokeShape>
                        <Label Text="AUDITORÍA RRU" TextColor="#0F2166" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                    </Border>

                    <ScrollView VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="ContenedorParadas" Spacing="15">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ItemParadaRRU">
                                    <Border BackgroundColor="White" Stroke="{Binding ColorBorde}" StrokeThickness="2" Padding="15">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="15"/>
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                            <Border Grid.Column="0" WidthRequest="30" HeightRequest="30" BackgroundColor="{Binding ColorIcono}" VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <Ellipse/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding NumeroStr}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Punto}" TextColor="#0F2166" FontSize="14" FontAttributes="Bold"/>
                                                <Label Text="{Binding Mensaje}" TextColor="#555" FontSize="12"/>
                                                <Label Text="{Binding InfoValidacion}" TextColor="{Binding ColorTextoInfo}" FontSize="11" FontAttributes="Italic" Margin="0,4,0,0"/>
                                            </VerticalStackLayout>
                                            <Image Grid.Column="2" Source="{Binding RutaImagenCompleta}" WidthRequest="60" HeightRequest="60" Aspect="AspectFill" IsVisible="{Binding TieneImagen}" VerticalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnImagenTapped" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="2" Margin="25,60,25,20" Spacing="12">

                <Border x:Name="BtnValidar" HeightRequest="55" WidthRequest="250" BackgroundColor="#43AAA0" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="31" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.12" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnValidarClicked" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblTxtValidar" Text="VALIDAR PARADA 1" TextColor="White" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Border x:Name="BtnFinalizar" HeightRequest="55" WidthRequest="250" IsVisible="False" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="31" />
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#43AAA0" Offset="1.0" />
                            <GradientStop Color="#243782" Offset="0.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.12" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFinalizarClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="FINALIZAR" TextColor="White" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" CharacterSpacing="1"/>
                </Border>

            </VerticalStackLayout>
        </Grid>

        <Border HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0, 105, 30, 0"
                WidthRequest="54"
                HeightRequest="54"
                BackgroundColor="White"
                StrokeThickness="0"
                ZIndex="100">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="27"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.15" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDocumentosClicked"/>
            </Border.GestureRecognizers>
            <Border.Content>
                <Label Text="📁" 
                       FontSize="24" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"
                       Margin="2,2,0,0"/>
            </Border.Content>
        </Border>

        <Grid x:Name="OverlayImagen" IsVisible="False" BackgroundColor="#E6000000" ZIndex="110">
            <ContentView x:Name="ContenedorZoom" Margin="10">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTappedReset" />
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </ContentView.GestureRecognizers>
                <Image x:Name="ImgAmpliada" Aspect="AspectFit" />
            </ContentView>

            <Border HorizontalOptions="End" VerticalOptions="Start" Margin="20,40" WidthRequest="45" HeightRequest="45" BackgroundColor="#99FFFFFF" ZIndex="999">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22.5"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCerrarImagenClicked"/>
                </Border.GestureRecognizers>
                <Label Text="✕" TextColor="Black" FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,50" Spacing="25" ZIndex="999">
                <Border WidthRequest="55" HeightRequest="55" BackgroundColor="Transparent" Stroke="White" StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="27.5"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnZoomOutClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="-" TextColor="White" FontSize="40" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Border>
                <Border WidthRequest="55" HeightRequest="55" BackgroundColor="Transparent" Stroke="White" StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="27.5"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnZoomInClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="+" TextColor="White" FontSize="40" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <Grid x:Name="OverlayDocumentos" 
              IsVisible="False" 
              BackgroundColor="#99000000" 
              ZIndex="999">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCerrarDocumentosClicked" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White"
                    Margin="25"
                    Padding="15"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto, *, Auto">

                    <Border StrokeThickness="2" 
                            Padding="20, 10"
                            WidthRequest="250"
                            BackgroundColor="Transparent"
                            Margin="0,0,0,10">
                        <Border.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#43AAA0" Offset="0.0" />
                                <GradientStop Color="#243782" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="45" />
                        </Border.StrokeShape>
                        <Border.Content>
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Label Text="DOCUMENTOS" 
                                       TextColor="#0F2166" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border.Content>
                    </Border>

                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" MaximumHeightRequest="500">
                        <StackLayout x:Name="ContenedorListaPdfs" Spacing="10" Margin="10" WidthRequest="250">
                        </StackLayout>
                    </ScrollView>

                    <Border Grid.Row="2"
                            Margin="0,10,0,20"
                            WidthRequest="250"
                            HeightRequest="50"
                            StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#43AAA0" Offset="1.0" />
                                <GradientStop Color="#243782" Offset="0.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,8" Opacity="0.2" Radius="10"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarDocumentosClicked" />
                        </Border.GestureRecognizers>
                        <Border.Content>
                            <Label Text="CERRAR" 
                                   TextColor="White" 
                                   CharacterSpacing="1"
                                   FontSize="16"
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Border.Content>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>